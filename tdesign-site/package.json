{
  "name": "tdesign-flutter",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "copy:readme": "node script/copy-readme.js",
    "test:theme": "node --test site/utils/flutterThemeBridge.test.mjs",
    "test:example-code": "node --test site/flutter-example-docs/*.test.mjs && node site/flutter-example-docs/check-docs.mjs",
    "site": "pnpm test:theme && pnpm test:example-code && cd site && vite build",
    "presite:dev": "npm run copy:readme",
    "dev": "node script/dev.mjs",
    "dev:site": "cd site && vite"
  },
  "author": "tdesign",
  "license": "MIT",
  "devDependencies": {
    "@tdesign/site-components": "^0.20.0",
    "@tdesign/theme-generator": "1.2.7",
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "~5.35.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^7.0.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-prettier": "^4.0.0",
    "gray-matter": "^4.0.3",
    "less": "^4.9.1",
    "prettier": "^2.0.5",
    "prismjs": "^1.30.0",
    "typescript": "~4.7.2",
    "vite": "^6.4.5",
    "vite-plugin-tdoc": "^2.0.1",
    "vue": "^3.5.44",
    "vue-router": "^4.0.11"
  }
}
